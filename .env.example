PORT=4003
AUTHORIZATION_HOST=127.0.0.1
HEALTH_PORT=9003
SERVICE_NAME=w-authorization
SERVICE_ADVERTISE_HOST=127.0.0.1
REGISTRY_URL=http://localhost:8500
# Một MongoDB database dùng chung cho mọi microservice (project-management); mỗi service chỉ đụng collection của mình.
MONGODB_URI=mongodb://admin:admin123@localhost:27017/project-management?authSource=admin
# Shared @lib-infrastructure/keycloak connection (service account, read-only use).
# Dev reuses the identity-service client; a dedicated authorization-service client comes later.
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=pm
KEYCLOAK_CLIENT_ID=identity-service
KEYCLOAK_CLIENT_SECRET=dev-identity-secret
KEYCLOAK_TIMEOUT_MS=3000
# Issuer of the actor supplied by the gateway
KEYCLOAK_ISSUER=http://localhost:8081/realms/pm
# Keycloak user id (sub) promoted to `admin` at boot. Idempotent. Printed by w-identity `seed:admin`.
# Re-applied on EVERY boot: while it is set, demoting this user is undone at the next restart.
# Use it for the first admin or to recover from a lost last admin, then clear it.
BOOTSTRAP_ADMIN_USER_ID=
